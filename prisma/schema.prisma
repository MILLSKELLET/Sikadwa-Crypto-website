datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  email               String         @unique
  password            String
  name                String
  phone               String?
  role                String         @default("user") // "user" or "admin"

  // Wallet balances
  localWallet         Float          @default(0)      // Local currency (e.g., GHS)
  usdWallet           Float          @default(0)      // USD equivalent
  btcWallet           Float          @default(0)      // BTC balance
  ethWallet           Float          @default(0)      // ETH balance

  // Relations to transactions where the user is either the buyer or seller
  buyerTransactions   Transaction[]  @relation("Buyer")
  sellerTransactions  Transaction[]  @relation("Seller")

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now())

  @@map("users")
}

model Transaction {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  buyerId        String   @db.ObjectId         // The user buying crypto
  sellerId       String   @db.ObjectId         // The user selling crypto

  currency       String   // e.g., "BTC", "ETH"
  amountCrypto   Float    // Amount of cryptocurrency being traded
  amountLocal    Float    // Local currency amount (e.g., GHS)
  status         String   @default("PENDING") // e.g., "PENDING", "COMPLETED", "CANCELLED"
  transactionRef String?  @unique             // Optional internal reference for tracking

  createdAt      DateTime @default(now())

  buyer          User     @relation("Buyer", fields: [buyerId], references: [id])
  seller         User     @relation("Seller", fields: [sellerId], references: [id])

  @@map("transactions")
}
