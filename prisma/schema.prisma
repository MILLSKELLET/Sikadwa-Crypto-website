datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum Currency {
  BTC
  ETH
  USDT
  GHS
  USD
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String  @unique
  password String
  name     String
  phone    String?
  role     String  @default("user")

  usdToCedisRate Float @default(0) // GHS wallet
  cedisToUsdRate Float @default(0) // USD wallet

  // Wallet balances
  localWallet Float @default(0) // GHS wallet
  usdWallet   Float @default(0) // USD equivalent
  btcWallet   Float @default(0) // BTC balance
  ethWallet   Float @default(0) // ETH balance

  // Transactions: Deposits to the platform
  transactions Transaction[]
  gigs         Gig[]

  // Orders: Buying & Selling crypto
  buyerOrders  Order[] @relation("Buyer")
  sellerOrders Order[] @relation("Seller")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Transaction {
  id       String          @id @default(auto()) @map("_id") @db.ObjectId
  userId   String          @db.ObjectId
  type     TransactionType // DEPOSIT or WITHDRAWAL
  currency String          @default("GHS") // Always in GHS
  amount   Float

  status         String  @default("pending") // pending, success, failed
  transactionRef String? @unique // Paystack or internal ref
  transactionId  String?
  provider       String? @default("Paystack") // "Paystack", "MobileMoney", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("transactions")
}

model Order {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  buyerId      String      @db.ObjectId
  sellerId     String      @db.ObjectId
  currency     Currency // BTC, ETH, USDT
  amountCrypto Float // Amount of crypto
  amountUSD    Float // USD equivalent (for pricing)
  status       OrderStatus @default(PENDING)
  orderRef     String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer  User @relation("Buyer", fields: [buyerId], references: [id])
  seller User @relation("Seller", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@map("orders")
}
enum GigType {
  BUY
  SELL
}

model Gig {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  title             String
  description       String
  currency          Currency // BTC, ETH, USDT
  price            Float // Price per unit of crypto
  quantityAvailable Float // Total quantity available (e.g., 2 BTC)
  type              GigType // "BUY" or "SELL"
  status            String @default("active") // active, completed, cancelled

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  User User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("gigs")
}


